<EntityForm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:dummy="0" flexi="1" fleximode="1" fullscreen="0" resize="0" version="2" layoutstrict="1" singlecardexpand="0" pagesposition="0" pageiconposition="0">
  <IsContactForm>false</IsContactForm>
  <EntityName>account</EntityName>
  <CamelCase>account</CamelCase>
  <SharedVariables>&lt;SharedVariables&gt;&lt;Variables&gt;&lt;/Variables&gt;&lt;/SharedVariables&gt;</SharedVariables>
  <IsBulkUpdateForm>false</IsBulkUpdateForm>
  <CacheMode>-1</CacheMode>
  <UiSyncGuardMode>-1</UiSyncGuardMode>
  <WorkflowLoad><![CDATA[<?xml version="1.0"?><Workflow e="true" isvalid="true" syntaxVersion="11" version="0">
  <branch e="true" info="">
    <if e="true">
      <conditions e="true" op="And">
        <condition e="false">
          <var>Entity.ownerid</var>
          <op>DoesNotContainData</op>
        </condition>
        <condition e="false">
          <var>Entity.createdon</var>
          <op>DoesNotContainData</op>
        </condition>
      </conditions>
      <action>
        <function e="false">
          <var>Entity.ownerid</var>
          <func>Assign</func>
          <arg>var:Configuration.systemuserid</arg>
        </function>
      </action>
    </if>
  </branch>
  <branch e="true" info="">
    <if e="true">
      <conditions e="true" op="And">
        <condition e="false">
          <var>Entity.IsNew</var>
          <op>Equal</op>
          <arg>Boolean:True</arg>
        </condition>
      </conditions>
      <action>
        <function e="false">
          <var>Form.^Create new order .IsVisible</var>
          <func>Assign</func>
          <arg>Boolean:False</arg>
        </function>
        <function e="false">
          <var>Form.^Create new appointment.IsVisible</var>
          <func>Assign</func>
          <arg>Boolean:False</arg>
        </function>
      </action>
    </if>
    <if e="true">
      <conditions e="true" op="And"/>
      <action>
        <function e="false">
          <var>Form.^Create new order .IsVisible</var>
          <func>Assign</func>
          <arg>Boolean:True</arg>
        </function>
        <function e="false">
          <var>Form.^Create new appointment.IsVisible</var>
          <func>Assign</func>
          <arg>Boolean:True</arg>
        </function>
      </action>
    </if>
  </branch>
  <function e="false">
    <var>Tabs.(activity.regardingobjectid.account).IsVisible</var>
    <func>Assign</func>
    <arg>Boolean:False</arg>
  </function>
</Workflow>]]></WorkflowLoad>
  <WorkflowButtonCommand><![CDATA[<?xml version="1.0"?><Workflow e="true" isvalid="true" syntaxVersion="11" version="0">
  <branch e="true" info="2020Q2 - Create a new order button">
    <if e="true">
      <conditions e="true" op="And">
        <condition e="false">
          <var>ChangedItem</var>
          <op>Equal</op>
          <arg>String:Create new order </arg>
        </condition>
      </conditions>
      <action>
        <definition e="false">
          <var>NewOrder</var>
          <func>NewInstance</func>
          <type>Entity</type>
          <arg>String:salesorder</arg>
        </definition>
        <function e="false">
          <var>NewOrder.customerid</var>
          <func>Assign</func>
          <arg>var:Entity.@this</arg>
        </function>
        <definition e="false">
          <var>OpenOrder</var>
          <func>Assign</func>
          <type>Lookup</type>
          <arg>var:NewOrder.@this</arg>
        </definition>
        <function e="false">
          <var>OpenOrder</var>
          <func>OpenForm</func>
          <arg>String:</arg>
        </function>
      </action>
    </if>
  </branch>
  <branch e="true" info="2020Q2 - Create a new event button">
    <if e="true">
      <conditions e="true" op="And">
        <condition e="false">
          <var>ChangedItem</var>
          <op>Equal</op>
          <arg>String:Create new appointment</arg>
        </condition>
      </conditions>
      <action>
        <definition e="false">
          <var>NewEvent</var>
          <func>NewInstance</func>
          <type>Entity</type>
          <arg>String:appointment</arg>
        </definition>
        <function e="false">
          <var>NewEvent.regardingobjectid</var>
          <func>Assign</func>
          <arg>var:Entity.@this</arg>
        </function>
        <definition e="false">
          <var>OpenEvent</var>
          <func>Assign</func>
          <type>Lookup</type>
          <arg>var:NewEvent.@this</arg>
        </definition>
        <function e="false">
          <var>OpenEvent</var>
          <func>OpenForm</func>
          <arg>String:</arg>
        </function>
      </action>
    </if>
  </branch>
</Workflow>]]></WorkflowButtonCommand>
  <PrimaryCommands>!defcmd</PrimaryCommands>
  <SharedVariableNames/>
  <ClassBinding/>
  <EnabledWorkflows>OnLoadEnabled OnChangeEnabled OnSaveEnabled OnExecuteCommand OnCanExecuteCommand OnExecuteButton</EnabledWorkflows>
  <SerializedChildrenV2>
