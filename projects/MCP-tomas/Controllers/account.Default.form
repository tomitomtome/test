      <Name>MOST ORDERED PRODUCTS</Name>
      <CustomName>MOST ORDERED PRODUCTS</CustomName>
      <Binding SchemaName="salesorderdetail.@virtual"/>
      <Views>&lt;extra&gt;&lt;filter entity="salesorderdetail"&gt;&amp;lt;fetch version="1.0"&amp;gt;&amp;lt;entity name="salesorderdetail"&amp;gt;&amp;lt;link-entity name="salesorder" from="salesorderid" to="salesorderid" link-type="inner" alias="L0"&amp;gt;&amp;lt;filter type="and"&amp;gt;&amp;lt;condition attribute="customerid" operator="eq" value="{{accountid}}" /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;/link-entity&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</Views>
      <LookupViews>product.Products</LookupViews>
      <Charts>salesorderdetail.@Products by Quantity</Charts>
